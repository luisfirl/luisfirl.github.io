---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Projects - Luis Firl"
  description="Research and computational projects by Luis Firl."
>
  <section class="section projects-section">
    <div class="container projects">
      <h1 class="eyebrow">Projects</h1>

      <article>
        <div class="project-meta">
          <span>Ongoing Research</span>
          <span>Systems Biology · Theoretical Biophysics</span>
        </div>

        <h2>
          <a href="/projects/signaling-networks">
            Data-driven Dynamic Modeling of Signaling Networks in
            Triple-Negative Breast Cancer
          </a>
        </h2>

        <p>
          An ongoing research project on inferring kinase signaling
          dependencies from time-resolved phosphoproteomic data and embedding
          them into mechanistic ODE models for dynamic simulation and
          perturbation analysis.
        </p>

        <a class="project-link" href="/projects/signaling-networks">
          Explore the research project →
        </a>
      </article>

      <article>
        <div class="project-meta">
          <span>Scientific ML</span>
          <span>Upcoming</span>
        </div>

        <h2>Machine Learning for Dynamical Systems</h2>

        <p>
          Future projects exploring modern machine learning approaches for
          biological and physical dynamical systems.
        </p>

        <p class="status">In development.</p>
      </article>
    </div>
  </section>
</Layout>

<style>
  .projects-section {
    padding: 7rem 0 5rem;
  }

  .projects > .eyebrow {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: 0.08em;
  }

  .projects {
    display: grid;
    gap: 1.5rem;
  }

  article {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 2.5rem;
  }

  .project-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    color: var(--muted);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  article h2 {
    margin: 2rem 0 1rem;
  }

  article p {
    max-width: 760px;
  }

  .status {
    color: var(--accent);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.85rem;
    margin-top: 2rem;
  }

  @media (max-width: 650px) {
    .project-meta {
      flex-direction: column;
    }
  }
</style>
