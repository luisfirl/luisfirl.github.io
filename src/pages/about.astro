---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import profileImage from '../assets/luis-firl-profile.jpg';
---

<Layout
  title="About | Luis Firl"
  description="About Luis Firl, computational life scientist interested in systems biology, theoretical biophysics and machine learning."
>
  <section class="page-hero">
    <div class="container profile-hero">
      <Image
        class="profile-image"
        src={profileImage}
        alt="Portrait of Luis Firl"
        width={280}
      />

      <div>
        <p class="eyebrow">About</p>
        <h1>Luis Firl</h1>
        <p class="profile-description">
          M.Sc. Life Science Engineering
        </p>
        <div class="profile-interests">
          <span>Systems Biology</span>
          <span>Theoretical Biophysics</span>
          <span>Mechanistic Modeling</span>
          <span>Scientific Machine Learning</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container about-grid">
      <div>
        <p class="eyebrow">Background</p>
        <h2>From Life Science Engineering to computational biology.</h2>
      </div>

      <div class="text">
        <p>
          I studied Life Science Engineering at HTW Berlin, where I developed
          an interdisciplinary background spanning biology, engineering and
          quantitative methods.
        </p>

        <p>
          I later completed my Master's thesis in Theoretical Biophysics at
          Humboldt-Universität zu Berlin, working on computational approaches
          to biological systems.
        </p>

        <p>
          I am particularly interested in research at the interface of
          mechanistic modeling and machine learning, and in developing
          computational methods that can help us understand complex biological
          dynamics.
        </p>
      </div>
    </div>
  </section>

  <section class="section contact">
    <div class="container">
      <p class="eyebrow">Connect</p>
      <h2>Find me online.</h2>

      <div class="links">
        <a href="https://github.com/luisfirl" target="_blank" rel="noreferrer">
          GitHub ↗
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding: 7rem 0 5rem;
    border-bottom: 1px solid var(--border);
  }

  .page-hero h1 {
    max-width: 950px;
    font-size: clamp(2.8rem, 6vw, 5rem);
  }

  .profile-hero {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 4rem;
    align-items: center;
  }

  .profile-image {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center 0%;
    border-radius: 50%;
  }

  .profile-description {
    max-width: 680px;
    font-size: 1.25rem;
    margin-top: 0.35rem;
    margin-bottom: 1.75rem;
  }

  .profile-interests {
    max-width: 680px;
    color: var(--muted);
    display: grid;
    grid-template-columns: max-content max-content;
    gap: 0.35rem 1.75rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.8rem;
    line-height: 1.8;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .profile-interests span {
    display: flex;
    gap: 0.5rem;
  }

  .profile-interests span::before {
    content: '•';
    color: var(--accent);
  }

  .profile-hero h1 {
    font-size: clamp(3.75rem, 8vw, 5.5rem);
    text-align: left;
    margin-left: -0.5rem;
    margin-bottom: 0;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 6rem;
  }

  .text {
    font-size: 1.1rem;
  }

  .text p:first-child {
    margin-top: 0;
  }

  .contact {
    background: var(--surface);
    border-top: 1px solid var(--border);
  }

  .links {
    display: flex;
    gap: 2rem;
    margin-top: 2rem;
  }

  .links a {
    color: var(--accent);
    font-weight: 600;
  }

  @media (max-width: 750px) {
    .profile-hero {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .profile-image {
      width: min(220px, 70vw);
    }

    .profile-interests {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .about-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>